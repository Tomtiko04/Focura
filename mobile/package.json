{
	"name": "focura-mobile",
	"version": "0.1.0",
	"private": true,
	"main": "index.js",
	"scripts": {
		"start": "expo start --clear",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"build:web": "expo export:web",
		"serve:web": "npx serve web-build"
	},
	"dependencies": {
		"@expo/metro-runtime": "~3.2.3",
		"@expo/vector-icons": "^14.0.2",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-navigation/bottom-tabs": "^6.5.20",
		"@react-navigation/native": "^6.1.18",
		"@react-navigation/native-stack": "^6.9.26",
		"axios": "^1.7.2",
		"core-js": "^3.45.1",
		"expo": "~51.0.0",
		"expo-asset": "~11.1.6",
		"expo-constants": "~15.4.1",
		"expo-dev-client": "~4.0.4",
		"expo-image-picker": "~17.0.2",
		"expo-linking": "~8.0.3",
		"expo-notifications": "~0.29.0",
		"expo-secure-store": "~15.0.2",
		"expo-status-bar": "~3.0.3",
		"focura-shared": "file:../shared",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-hook-form": "^7.52.0",
		"react-native": "0.74.2",
		"react-native-gesture-handler": "~2.16.1",
		"react-native-reanimated": "~3.10.1",
		"react-native-safe-area-context": "^4.10.5",
		"react-native-screens": "~3.31.1",
		"react-native-svg": "^15.12.1",
		"react-native-web": "~0.19.10",
		"react-native-webview": "13.8.1",
		"styled-components": "^6.1.11",
		"zustand": "^4.5.7"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/plugin-proposal-export-namespace-from": "^7.21.4-esm.4",
		"@babel/plugin-transform-runtime": "^7.25.4",
		"@babel/preset-env": "^7.25.4",
		"@babel/preset-react": "^7.24.1",
		"@babel/preset-typescript": "^7.24.1",
		"babel-plugin-module-resolver": "^5.0.0",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"babel-preset-expo": "~9.2.0",
		"react-native-dotenv": "^3.4.11"
	},
	"jest": {
		"preset": "react-native",
		"transformIgnorePatterns": [
			"node_modules/(?!(@expo|expo|react-native|react-native-webview|@react-navigation|@react-native-async-storage/async-storage)/)"
		],
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.js"
		],
		"moduleNameMapper": {
			"^focura-shared$": "<rootDir>/../shared/src"
		}
	},
	"browserslist": [
		"defaults",
		"not IE 11",
		"not IE_Mob 11",
		"maintained node versions"
	]
}
